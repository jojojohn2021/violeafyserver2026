# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"


# FIRESTORE_DATABASE_ID: Secure server-side environment variable for Firebase Firestore Database ID
# e.g., violeafydb or (default)
FIRESTORE_DATABASE_ID="violeafydb"

# FIREBASE_DATABASE_ID: Alternative server-side environment variable for Firebase Database ID
FIREBASE_DATABASE_ID="violeafydb"

# FIREBASE_CONFIG: Secure server-side JSON string configuration for Firebase connection
# e.g. '{"projectId":"violeafybasket","appId":"...","apiKey":"...","authDomain":"...","firestoreDatabaseId":"violeafydb"}'
FIREBASE_CONFIG=

# FIREBASE_PROJECT_ID: Firebase Project ID
FIREBASE_PROJECT_ID="violeafybasket"

# FIREBASE_API_KEY: Firebase Web API Key (client key, safe to expose to browser, but keep sample generic)
FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"

# FIREBASE_AUTH_DOMAIN: Firebase Auth Domain
FIREBASE_AUTH_DOMAIN="violeafybasket.firebaseapp.com"

# FIREBASE_APP_ID: Firebase App ID
FIREBASE_APP_ID="1:347630935812:web:0a0e7689a0e7e9d59b3a51"

# FIREBASE_STORAGE_BUCKET: Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET="violeafybasket.firebasestorage.app"

# FIREBASE_SERVICE_ACCOUNT_KEY: JSON key for Firebase Admin SDK.
# Set this in Firebase App Hosting secrets (not in repository files).
# Value format options supported by firebase-admin.ts:
# 1) Raw JSON string: {"type":"service_account",...}
# 2) Absolute file path to key JSON (local development only)
FIREBASE_SERVICE_ACCOUNT_KEY=""
